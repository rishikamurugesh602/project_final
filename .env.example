# Application Settings
APP_NAME=Real-Time Deepfake Voice Interceptor
APP_VERSION=1.0.0
DEBUG=False

# ML Model Configuration
MODEL_DEVICE=cpu
# MODEL_DEVICE=cuda  # Uncomment for GPU

# Whisper ASR Configuration
WHISPER_MODEL=base
# Options: tiny, base, small, medium, large

# Deepfake Detection Configuration
DEEPFAKE_THRESHOLD=0.5
DEEPFAKE_WEIGHT=0.5
DEEPFAKE_MODEL_PATH=models/checkpoints/deepfake_detector_best.pt

# Scam Intent Detection Configuration
SCAM_THRESHOLD=0.5
SCAM_WEIGHT=0.5
SCAM_MODEL_PATH=models/checkpoints/scam_detector.pt

# Risk Level Thresholds
RISK_LOW_THRESHOLD=0.39
RISK_MEDIUM_THRESHOLD=0.69
RISK_HIGH_THRESHOLD=1.0

# Audio Processing Configuration
SAMPLE_RATE=16000
CHUNK_DURATION=1.0
SILENCE_THRESHOLD=0.02
ENABLE_NOISE_REDUCTION=true

# Database Configuration
DATABASE_URL=sqlite:///./data/app.db
ENABLE_AUDIO_STORAGE=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
